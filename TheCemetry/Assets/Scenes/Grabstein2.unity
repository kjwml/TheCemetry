      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961217864587457082, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_Name
      value: DialogManager
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1693469880}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "\u201CWhere we\u2019re from, we don\u2019t bring the dead flowers they
        liked. We bring them what helped them survive; Food, light, something familiar
        enough to find their way back. The dead usually don\u2019t arrive empty-handed,
        but she shouldn\u2019t arrive hungry either. She has far to travel after
        all. She was already born exhausted.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "\u2026 That sounds cruel coming from me, but\u2026 it\u2019s true.
        I forced her to enter the world already carrying weight that was never hers.
        She tried to put it down. She crossed borders for that. Left me behind for
        that. She never stopped being my daughter because she made mistakes. They
        say what she did - The people who hear the wrong parts of her story first,
        I mean. They never ask why she was cornered into it. She stopped being seen
        as human long before she\u2026 died."
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "He learned this place\u2019s rules better than most people born into
        them. And still, it wasn\u2019t enough. I keep finding myself defending him
        to strangers. As if love needs documentation. He deserved to be met as a
        person first. That\u2019s the part they skipped.\u201D"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
