  m_Script: {fileID: 11500000, guid: e2effc6c8484a4541877dbfe23a82f8a, type: 3}
  m_Name: NPC_Dialogue
  m_EditorClassIdentifier: 
  sentences:
  - name: Stranger
    text: "I didn\u2019t know her. I want to be clear about that. I came because
      I didn\u2019t want her to disappear into headlines. "
  - name: Stranger
    text: "I learned her name the same way I learned the others\u2019. From a list.
      That didn\u2019t feel right."
  - name: Stranger
    text: There were a lot of people at the vigil. Someone brought fabric, tied it
      where people could see it move in the wind.
  - name: Stranger
    text: Someone else lit something and stayed until it burned down. No one told
      them to. It just felt wrong to leave things bare.
