      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1065521921966348606, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_LocalRotation.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1065521921966348606, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_LocalRotation.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1065521921966348606, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
