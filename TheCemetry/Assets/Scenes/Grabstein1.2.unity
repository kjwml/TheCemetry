      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961217864587457082, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_Name
      value: DialogManager
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1150316918}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: delayBetweenLines
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "What he was like? People keep asking me what he was like. As if that\u2019s
        difficult, you don\u2019t have to ask me for that. Ah, Askim\u2026 He always
        woke up earlier than he needed to. Said food tastes better when you make
        it before the world gets loud. I used to complain about the smell of oil
        in his clothes. Now I miss it. "
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "The stand wasn\u2019t just work. It kept us afloat. It was\u2026 how
        he stayed visible. Everyone knew where to find him. *They* keep asking questions.
        Not about the day itself. About him. What kind of people came by. What he
        talked about. As if kindness could be suspicious. As if the problem started
        at our counter."
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "If you\u2019re taking care of the grave, don\u2019t make it grand.
        He never liked things that tried too hard. He liked simple things. Warm food.
        A clean counter. Knowing someone would be fed before school let out\u2026
        That\u2019s enough."
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: 
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
