      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1065521921966348606, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1961217864587457082, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: m_Name
      value: DialogManager
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 439090841}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "If you\u2019re taking care of the grave, don\u2019t make it grand.
        He never liked things that tried too hard. He liked simple things. Warm food.
        A clean counter. Knowing someone would be fed before school let out\u2026
        That\u2019s enough.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "\u201CPeople think grief is loud. It isn\u2019t. It\u2019s waking up
        and realizing you don\u2019t know what to do with the morning anymore.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "\u201CYou\u2019re that cleaner from yesterday, yes? Anne told me. Thank
        you for this, he\u2026 I know he\u2019d be grateful too. Reminds me of how
        he always used to pack extra napkins. I also always told him we didn\u2019t
        need them. \u2018Someone always does\u2019, he\u2019d say, you know? I didn\u2019t
        like standing near the stand after school. Convenient for the food. For me.
        For the others. Everyone knew me if they knew him. Now I keep wishing I stayed
        longer.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 5551166701328841805, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "Witness ; NPC  \u201CI was there earlier. Not when it happened - Before.
        Two people came by. Didn\u2019t buy anything. Just stood too close. I remember
        thinking they were waiting for someone else. I keep wondering what would\u2019ve
        happened if I\u2019d stayed.\u201D "
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 591f22c37e35f7f44956c84cd882c910, type: 3}
